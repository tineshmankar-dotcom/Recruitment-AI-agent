# ==============================================
# RecruitIQ Environment Variables
# ==============================================

# Backend (FastAPI)
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="RecruitIQ Backend"
API_V1_STR="/api"

# Database Configuration (PostgreSQL / SQLite)
# For PostgreSQL (Production):
# DATABASE_URL="postgresql://user:password@localhost:5432/recruitiq"
# For SQLite (Local Default):
DATABASE_URL="sqlite:///./recruitiq.db"

# Storage
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# Vector Database (Phase 3 Preparation)
# VECTOR_DB_TYPE="pgvector" # Options: pgvector, faiss
# EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:8000"
